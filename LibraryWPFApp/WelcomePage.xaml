<Page x:Class="LibraryWPFApp.WelcomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:LibraryWPFApp"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="WelcomePage">

    <Grid>

        <Grid.Background>
            <ImageBrush ImageSource="LibraryBG.jpg"/>
        </Grid.Background>

        <TextBlock Text="Bookworm Library"
               FontSize="70" 
               FontWeight="Bold" 
               Foreground="#FFF5CEAA"
               HorizontalAlignment="Center" 
               VerticalAlignment="Top"
               Margin="0,50">
            <TextBlock.Effect>
                <DropShadowEffect Color="Black" 
                              BlurRadius="20" 
                              ShadowDepth="1" 
                              Opacity="1" />
            </TextBlock.Effect>
        </TextBlock>

        <Border Style="{StaticResource BorderHoverStyle}">
            <Button
            x:Name="categoriesNavBtn"
            Content="Browse Categories"
            Style="{StaticResource btnsStyle}"
            Click="categoriesNavBtn_Click"/>
        </Border>
    </Grid>
</Page>
