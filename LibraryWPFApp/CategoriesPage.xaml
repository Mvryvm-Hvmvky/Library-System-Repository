<Page x:Class="LibraryWPFApp.CategoriesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:LibraryWPFApp"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="CategoriesPage">
    
    <Grid Style="{StaticResource BG}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Choose a Category"
               FontSize="50" 
               FontWeight="Bold" 
               Foreground="Black"
               HorizontalAlignment="Center" 
               VerticalAlignment="Center"
               Grid.Row="0" 
               Margin="0,20,0,20" />
        <Grid Grid.Row="1">
            <Border CornerRadius="5"
                Background="Gray" 
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Height="226"
                Width="200">
            <ListBox x:Name="categoriesListBox"
                 Background="Transparent"
                 BorderBrush="Transparent">
                <ListBoxItem Content="Horror" Style="{StaticResource ListBoxItems}" />
                <ListBoxItem Content="Fiction" Style="{StaticResource ListBoxItems}" />
                <ListBoxItem Content="Sci-Fi" Style="{StaticResource ListBoxItems}" />
                <ListBoxItem Content="Mystery" Style="{StaticResource ListBoxItems}" />
                <ListBoxItem Content="Graphic Novel" Style="{StaticResource ListBoxItems}" />
                <ListBoxItem Content="Fairy Tales" Style="{StaticResource ListBoxItems}" />
                <ListBoxItem Content="Romance" Style="{StaticResource ListBoxItems}" />
            </ListBox>
        </Border>
        </Grid>

        <Grid Grid.Row="1">
        <Border CornerRadius="5"
                Background="#FF1557F7"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Grid.Row="1"
                Height="226"
                Width="35">
            <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Height="226">
                <TextBlock Text="1" Style="{StaticResource NumberingTextBlocks}"/>
                <TextBlock Text="2" Style="{StaticResource NumberingTextBlocks}"/>
                <TextBlock Text="3" Style="{StaticResource NumberingTextBlocks}"/>
                <TextBlock Text="4" Style="{StaticResource NumberingTextBlocks}"/>
                <TextBlock Text="5" Style="{StaticResource NumberingTextBlocks}"/>
                <TextBlock Text="6" Style="{StaticResource NumberingTextBlocks}"/>
                <TextBlock Text="7" Style="{StaticResource NumberingTextBlocks}"/>
            </StackPanel>
        </Border>
        </Grid>
        <Border Style="{StaticResource BorderHoverStyle}"
            Grid.Row="2">
            <Button x:Name="booksPageNavBtn"
                Content="View Books"
                Grid.Row="2"
                Style="{StaticResource btnsStyle}"
                Click="booksPageNavBtn_Click"/>
        </Border>
    </Grid>
</Page>
